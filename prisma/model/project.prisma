// Prisma Next contract — validated by `npx prisma contract emit`, not the
// Prisma ORM 7 language server (see .vscode/settings.json).
enum ProjectStatus {
  @@type("pg/text@1")
  DRAFT    = "DRAFT"
  ARCHIVED = "ARCHIVED"
}

model Project {
  id             String               @id @default(uuid())
  ownerId        String
  name           String
  description    String?
  status         ProjectStatus        @default(DRAFT)
  canvasJsonPath String?
  createdAt      TimestamptzString    @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([ownerId])
  @@index([createdAt])
}

model ProjectCollaborator {
  id        String             @id @default(uuid())
  projectId String
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email     String
  createdAt TimestamptzString  @default(now())

  @@unique([projectId, email])
  @@index([email])
  @@index([projectId, createdAt])
}
